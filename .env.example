# design-extractor optional API keys
# Copy this file to .env and fill in the keys you want to use.
# None are required — the pipeline runs without any of them.
# Shell-exported values always override .env values.

# -- Press-kit extraction (scripts/brand_kit_extractor.py) --

# SerpAPI — Google search to discover press-kit URLs as a last-resort fallback.
# Signup: https://serpapi.com/users/sign_up  (free: 100 searches/mo)
# Only used when path probing returns nothing.
SERP_API_KEY=

# Firecrawl — JS-rendered page scraping. Preferred when available.
# Signup: https://firecrawl.dev  (free: 500 credits)
FIRECRAWL_API_KEY=

# Cloudflare Browser Rendering — alternative JS-rendered scraping via
# Cloudflare's managed headless Chrome.
# Docs: https://developers.cloudflare.com/browser-rendering/
# Free tier: 10k requests/day on a Workers Paid plan.
# Both values required together.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
